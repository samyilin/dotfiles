FROM ubuntu:latest

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# unminimize was removed in Ubuntu 26.04; replicate its effect inline:
# drop dpkg's path-excludes, then reinstall packages so man/docs are restored.
RUN rm -f /etc/dpkg/dpkg.cfg.d/excludes && \
  apt-get update && \
  apt-get -y upgrade && \
  apt-get install -y --no-install-recommends \
  xz-utils \
  man-db \
  curl \
  wget \
  less \
  iproute2 \
  unzip \
  texinfo \
  info \
  openssh-client \
  tmux \
  git \
  vim \
  neovim \
  ripgrep \
  fd-find \
  shellcheck \
  busybox \
  iputils-ping \
  bash-completion \
  starship \
  lazygit && \
  ln -sf /usr/bin/fdfind /usr/bin/fd && \
  apt-get install -y --reinstall --no-install-recommends \
  $(dpkg --get-selections | awk '{print $1}') && \
  rm -f /usr/bin/man && \
  dpkg-divert --quiet --remove --rename /usr/bin/man && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

COPY . /usr/share/workspace
WORKDIR /usr/share/workspace
RUN ./setup.sh -d

CMD ["/bin/bash"]
