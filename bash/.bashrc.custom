#!/usr/bin/env bash
##################################################################
# This is my personal bashrc section.

# If not running interactively, don't do anything
case $- in
*i*) test -f "$HOME"/.inputrc && bind -f "$HOME"/.inputrc ;;
*) return ;;
esac

# Force end POSIX mode, somehow Kitty won't reset POSIX mode
set +o posix
# vi mode
set -o vi
# Append to the history file, don't overwrite it
shopt -s histappend
# check the window size after each command and, if necessary, update the
# values of LINES and COLUMNS
shopt -s checkwinsize
# Don't put duplicate lines or lines starting with space in the history
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=5000
HISTFILESIZE=10000
export PROMPT_COMMAND="history -a; history -c; history -r; $PROMPT_COMMAND"

# launches emacs in server mode if not already running. Optional code.
# You would know what I mean here if you've used emacs extensively.

# if command -V emacs &>/dev/null && ! pgrep -x "emacs" > /dev/null ; then
#      emacs --daemon 2>/dev/null && echo "Emacs running in server mode"
# fi

# This line is executed upon exiting shell. Currently it tries to kill
# emacs, be careful though. you may not want this.
# function cleanup {
#   if pgrep -x "emacs" > /dev/null
#   then
#     killall emacs
#   fi
# }
# trap cleanup exit
#
# A command to automatically update all git repos to latest if they're
# currently on the default branch.
update_repos() {
  dir=$(pwd)
  failed=0
  printf "Attempting to update all git repos under folder to the latest default branch...\n"
  # The agent unlock below only matters for SSH remotes, so first find
  # the repos and note whether any uses an SSH remote.
  git_repos=0
  ssh_repos=0
  for i in "$dir"/*; do
    i="${i%*/}"
    i="${i##*/}"
    [ -d "$dir/$i/.git" ] || continue
    git_repos=$((git_repos + 1))
    remote="$(git -C "$dir/$i" remote | sed -n '1p')"
    if [ -n "$remote" ]; then
      url="$(git -C "$dir/$i" remote get-url "$remote" 2>/dev/null)"
      case "$url" in
      http://* | https://* | file://*) ;;
      *:*) ssh_repos=$((ssh_repos + 1)) ;;
      esac
    fi
  done
  if [ "$git_repos" -eq 0 ]; then
    printf "No git repos found under %s.\n" "$dir"
    return 0
  fi
  # Unlock SSH keys once for 5m so pulls don't re-prompt. Reuse a
  # fixed-socket agent so repeated runs share one daemon instead of
  # leaking a new one.
  if [ "$ssh_repos" -gt 0 ]; then
    sock="$HOME/.ssh/agent.sock"
    ssh-add -l >/dev/null 2>&1
    agent=$?
    if [ "$agent" -eq 2 ]; then
      SSH_AUTH_SOCK="$sock"
      export SSH_AUTH_SOCK
      ssh-add -l >/dev/null 2>&1
      agent=$?
      if [ "$agent" -eq 2 ]; then
        mkdir -p "$HOME/.ssh"
        rm -f "$sock"
        eval "$(ssh-agent -a "$sock" -s)" >/dev/null 2>&1 || return 1
      fi
    fi
    # Agent is reachable; leave a populated one alone. Otherwise add
    # the default-named keys plus custom-named ones declared via
    # IdentityFile in ~/.ssh/config, all with a 5-minute lifetime.
    if ! ssh-add -l >/dev/null 2>&1; then
      ssh-add -t 5m >/dev/null 2>&1
      sed -n 's@^[[:space:]]*[Ii]dentityFile[[:space:]]\+@@p' \
        "$HOME"/.ssh/config 2>/dev/null |
        while IFS= read -r key; do
          if [ -n "$key" ]; then
            ssh-add -t 5m "${key/#\~/$HOME}" >/dev/null 2>&1
          fi
        done
      if ! ssh-add -l >/dev/null 2>&1; then
        printf "No SSH keys loaded; pulls may prompt per repo.\n"
      fi
    fi
  fi
  for i in "$dir"/*; do
    i="${i%*/}"
    i="${i##*/}"
    if [ -d "$dir/$i/.git" ]; then
      remote="$(git -C "$dir/$i" remote | sed -n '1p')"
      if [ -n "$remote" ]; then
        default_branch="$(git -C "$dir/$i" symbolic-ref "refs/remotes/$remote/HEAD" 2>/dev/null | sed 's@^refs/remotes/[^/]*/@@')"
        if [ -z "$default_branch" ]; then
          default_branch="$(git -C "$dir/$i" ls-remote --symref "$remote" HEAD 2>/dev/null | sed -n '1s@^ref: refs/heads/@@p' | cut -f1)"
        fi
        if [ -z "$default_branch" ]; then
          printf "\342\235\214 Git repo %s: could not determine the default branch, skipping.\n" "$i"
        else
          current_branch="$(git -C "$dir/$i" branch --show-current)"
          if [ -z "$current_branch" ]; then
            printf "\342\235\214 Git repo %s is in detached HEAD state, skipping.\n" "$i"
          elif [ "$current_branch" = "$default_branch" ]; then
            if git -C "$dir/$i" pull --quiet; then
              printf "\342\234\224 Git repo %s updated to the latest %s branch.\n" "$i" "$default_branch"
            else
              printf "\342\235\214 Git repo %s: pull failed.\n" "$i"
              failed=1
            fi
          else
            printf "\342\235\214 Git repo %s not on the default branch. Default branch is %s, but repo is in %s branch.\n" "$i" "$default_branch" "$current_branch"
          fi
        fi
      else
        printf "\342\235\214 Git repo %s is local only, no need to update.\n" "$i"
      fi
    fi
  done
  return "$failed"
}

has() {
  # If the shell itself provides the name (alias, builtin, keyword, or
  # function), it is available even without a PATH executable.
  case "$(type "$1" 2>&1)" in
  *alias* | *builtin* | *keyword* | *function*) return 0 ;;
  *) ;;
  esac
  cmd="$(command -v "$1" 2>/dev/null)" || return 1
  [ -x "$cmd" ]
}
# Use Starship prompt if present.
if has starship; then
  eval "$(starship init bash)"
else
  # prompt setting. Funny combination of Ubuntu and Fedora.
  PS1='\[\033[01;32m\][\u@\H \w]\[\033[00m\]\\$ '
fi
