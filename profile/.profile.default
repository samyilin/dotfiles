#!/bin/sh
# login loads this file before bashrc, so put here just in case
if [ -n "$BASH_VERSION" ]; then
  # include .bashrc if it exists
  if [ -f "$HOME/.bashrc" ]; then
    #shellcheck disable=SC1091
    . "$HOME"/.bashrc
  fi
else
  # simple prompt for shells other than Bash, expanded once at login.
  PS1="[$(id -un)@$(uname -n) $(basename "$PWD")]$ "
fi

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/bin" ]; then
  PATH="$HOME/bin:$PATH"
fi

# set PATH so it includes user's private .local/bin if it exists
if [ -d "$HOME/.local/bin" ]; then
  PATH="$HOME/.local/bin:$PATH"
fi
has() {
  # If the shell itself provides the name (alias, builtin, keyword, or
  # function), it is available even without a PATH executable.
  case "$(type "$1" 2>&1)" in
  *alias* | *builtin* | *keyword* | *function*) return 0 ;;
  *) ;;
  esac
  cmd="$(command -v "$1" 2>/dev/null)" || return 1
  [ -x "$cmd" ]
}
# Set up Homebrew PATH early so brew-installed tools are found below.
if has brew; then
  brew_prefix="$(brew --prefix)"
  export PATH="$brew_prefix/bin:$PATH"
  export PATH="$brew_prefix/sbin:$PATH"
  if [ -f "$brew_prefix/etc/profile.d/bash_completion.sh" ]; then
    . "$brew_prefix/etc/profile.d/bash_completion.sh"
  fi
fi
# I don't care for dircolors, but put in here just in case.
if has dircolors; then
  if [ -r "$HOME"/.dircolors ]; then
    eval "$(dircolors -b "$HOME"/.dircolors)"
  else
    eval "$(dircolors -b)"
  fi
elif has gdircolors; then
  if [ -r "$HOME"/.dircolors ]; then
    eval "$(gdircolors -b "$HOME"/.dircolors)"
  else
    eval "$(gdircolors -b)"
  fi
fi
# Fall back to the busybox vi applet if vi is missing.
if ! command -v vi >/dev/null 2>&1 &&
  command -v busybox >/dev/null 2>&1; then
  #shellcheck disable=SC2139
  alias vi="busybox vi"
fi
if has nvim; then
  export EDITOR="nvim"
fi
if has rg; then
  export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"
fi
if has fastfetch; then
  fastfetch
fi
alias ls='ls --color=auto'
alias grep='grep --color=auto'

# Add this for WSL corporate desktop. There's annoyance on corporate Windows.
if [ -d /proc ]; then
  version="$(cat /proc/version)"
  case "$version" in
  *microsoft*)
    alias network="sudo chattr -i /etc/resolv.conf && sudo vim /etc/resolv.conf && sudo chattr +i /etc/resolv.conf"
    ;;
  *) ;;
  esac
fi
