theme = dark:Gruvbox Material,light:Gruvbox Light
fullscreen = true
mouse-hide-while-typing = true
# Keybinding to rename tab
keybind = cmd+r=prompt_surface_title
window-padding-y = 0
window-padding-balance = true
window-padding-color = extend

font-family = "Maple Mono NF CN"
# Match kitty: disable programming ligatures
font-feature = -calt
# https://ghostty.org/docs/help/terminfo
shell-integration-features = ssh-terminfo,ssh-env,sudo,path
# Notify when a command finishes in an unfocused terminal
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
# copy on select
copy-on-select = clipboard

# Bind Command + ` (backtick) to toggle the quick terminal globally
keybind = global:super+grave_accent=toggle_quick_terminal

# Optional customization
quick-terminal-position = center
quick-terminal-size = 80%,80%
quick-terminal-autohide = true
